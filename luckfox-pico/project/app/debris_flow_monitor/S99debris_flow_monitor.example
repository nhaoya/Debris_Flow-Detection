#!/bin/sh
# Example Buildroot init script for unattended field boot.
# Copy to /etc/init.d/S99debris_flow_monitor and edit DEVICE_ID per node.

APP=/oem/usr/bin/debris_flow_monitor
PIDFILE=/var/run/debris_flow_monitor.pid
LOG=/tmp/debris_flow_monitor.log
DEVICE_ID=1

start_app() {
    # rkipc and debris_flow_monitor must not own RKAIQ/ISP at the same time.
    killall rkipc 2>/dev/null || true
    sleep 1
    export LD_LIBRARY_PATH=/oem/usr/lib
    "$APP" --device-id "$DEVICE_ID" >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
}

stop_app() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        kill -INT "$PID" 2>/dev/null || true
        rm -f "$PIDFILE"
    else
        killall -INT debris_flow_monitor 2>/dev/null || true
    fi
}

case "$1" in
    start) start_app ;;
    stop) stop_app ;;
    restart) stop_app; sleep 1; start_app ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
